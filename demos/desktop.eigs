# MD: the list-driven WM — windows ARE observed bindings, now as data.
#
# window = task = EigsState (M9); pixels = M9.5 viewports. The WM is
# script: each window is a RECORD in `wins` (back-to-front z-order,
# focused = last), and every WM operation — hit-test, focus, drag, key
# routing, drawing, teardown — iterates the list. Adding a window is
# one spawn_win call; nothing else grows. Hit-testing scans front-to-
# back, so the topmost window under the pointer wins by construction.
#
# The one thing that stays NAMED: observer slots. A trajectory
# accumulates on a BINDING (`stable of p0` reads the history of
# assignments to p0); a list element has no binding identity, so each
# window's progress samples land in the fixed scalars p0..p7,
# dispatched by the record's slot index. 8 slots = the window budget;
# spawn_win refuses a 9th loudly rather than silently dropping the
# observation.
#
#   import desktop     click focuses (focused window draws on top) -
#                      drag a title bar to move a window - drag the
#                      bottom-right grip to resize it (tasks adapt via
#                      win_w/win_h; the kernel clip does the rest) -
#                      keys go to the focused window (counter: any key
#                      adds 10) - the repl window is a real EigenScript
#                      REPL on its own isolated EigsState - ESC quits
#
# Windows: win_counter (draws + takes keys), win_bounce (always
# advancing), task_stuck (the M9 wedged worker — its title turns red
# because its progress reads stable), win_repl (type into it: the WM
# edits the line, task_eval runs it on the window's own state and the
# result comes back as a by-value string), win_vitals (the machine
# watching itself).

import list

define chrome(cx, cy, cw, ch, focused, stalled) as:
    # border ring + title bar + content backdrop for one window
    gfx_rect of [cx - 2, cy - 26, cw + 4, ch + 30, 70, 76, 96]
    if stalled == 1:
        gfx_rect of [cx, cy - 24, cw, 22, 168, 40, 40]
    if stalled == 0:
        if focused == 1:
            gfx_rect of [cx, cy - 24, cw, 22, 46, 90, 150]
        if focused == 0:
            gfx_rect of [cx, cy - 24, cw, 22, 40, 46, 64]
    gfx_rect of [cx, cy, cw, ch, 14, 16, 26]
    return 0

define spawn_win(mod, wx, wy, ww, wh, title, kind) as:
    # one call = one window: spawn the task state, give it a viewport,
    # claim an observer slot, append the record. wins/nslots are
    # module bindings — `is` updates them outward.
    if nslots >= 8:
        throw of "desktop: out of observer slots (8 windows max)"
    local id is task_spawn of mod
    task_view of [id, wx, wy, ww, wh]
    append of [wins, {"id": id, "x": wx, "y": wy, "w": ww, "h": wh, "title": title, "kind": kind, "slot": nslots}]
    nslots is nslots + 1
    return 0

define sample_health(slot, id) as:
    # the slot dispatch — the one branch chain the language requires:
    # only a named scalar has a trajectory. + 0.0 forces a fresh value
    # so no alias ever splits it.
    local v is task_read of [id, "progress"]
    if slot == 0:
        p0 is v + 0.0
        return stable of p0
    if slot == 1:
        p1 is v + 0.0
        return stable of p1
    if slot == 2:
        p2 is v + 0.0
        return stable of p2
    if slot == 3:
        p3 is v + 0.0
        return stable of p3
    if slot == 4:
        p4 is v + 0.0
        return stable of p4
    if slot == 5:
        p5 is v + 0.0
        return stable of p5
    if slot == 6:
        p6 is v + 0.0
        return stable of p6
    if slot == 7:
        p7 is v + 0.0
        return stable of p7
    return 0

define hit(px, py, rec) as:
    # window rect including chrome (title bar + border)
    if (px >= rec.x - 2) and (px < rec.x + rec.w + 2) and (py >= rec.y - 26) and (py < rec.y + rec.h + 4):
        return 1
    return 0

define in_title(py, rec) as:
    if (py >= rec.y - 26) and (py < rec.y):
        return 1
    return 0

define in_grip(px, py, rec) as:
    # bottom-right resize grip, content corner + border
    if (px >= rec.x + rec.w - 14) and (px < rec.x + rec.w + 2) and (py >= rec.y + rec.h - 14) and (py < rec.y + rec.h + 4):
        return 1
    return 0

define to_top(idx) as:
    # move wins[idx] to the end (front of the z-order)
    local out is []
    local n is len of wins
    local i is 0
    loop while i < n:
        if i != idx:
            append of [out, wins[i]]
        i is i + 1
    append of [out, wins[idx]]
    wins is out
    return 0

define press(px, py) as:
    # front-to-back hit scan: the topmost window under the point gets
    # focus; a grip hit starts a resize, a title-bar hit a drag.
    # drag/rsz/gdx/gdy are module bindings — the outward mutation is
    # this helper's job. For a resize the grab offset is kept from the
    # bottom-right CORNER, so the corner tracks the pointer.
    local i is (len of wins) - 1
    local rec is null
    loop while i >= 0:
        rec is wins[i]
        if (hit of [px, py, rec]) == 1:
            if (in_grip of [px, py, rec]) == 1:
                rsz is rec.id
                gdx is px - (rec.x + rec.w)
                gdy is py - (rec.y + rec.h)
            else:
                if (in_title of [py, rec]) == 1:
                    drag is rec.id
                    gdx is px - rec.x
                    gdy is py - rec.y
            to_top of i
            return 1
        i is i - 1
    return 0

define find_win(id) as:
    local i is 0
    loop while i < (len of wins):
        if wins[i].id == id:
            return i
        i is i + 1
    return 0 - 1

define drag_to(px, py) as:
    local i is find_win of drag
    if i < 0:
        return 0
    local rec is wins[i]
    rec.x is px - gdx
    rec.y is py - gdy
    if rec.y < 34:
        rec.y is 34
    if rec.x < 4:
        rec.x is 4
    task_view of [rec.id, rec.x, rec.y, rec.w, rec.h]
    return 0

define resize_to(px, py) as:
    # the grabbed corner follows the pointer; minimums keep the title
    # text and the grip itself reachable
    local i is find_win of rsz
    if i < 0:
        return 0
    local rec is wins[i]
    rec.w is px - gdx - rec.x
    rec.h is py - gdy - rec.y
    if rec.w < 120:
        rec.w is 120
    if rec.h < 60:
        rec.h is 60
    task_view of [rec.id, rec.x, rec.y, rec.w, rec.h]
    return 0

define draw_one(rec, focused, stalled) as:
    chrome of [rec.x, rec.y, rec.w, rec.h, focused, stalled]
    gfx_text of [rec.x + 8, rec.y - 18, rec.title, 220, 226, 240, 1]
    if stalled == 1:
        gfx_text of [rec.x + rec.w - 66, rec.y - 18, "(stalled)", 255, 150, 150, 1]
    if rec.kind == "repl":
        # the WM renders the transcript on the repl window's behalf,
        # clipped to the window rect (hosted-parity gfx_clip)
        gfx_clip of [rec.x, rec.y, rec.w, rec.h]
        local i is 0
        for tl in rlines:
            gfx_text of [rec.x + 6, rec.y + 6 + i * 16, tl, 185, 205, 185, 1]
            i is i + 1
        gfx_text of [rec.x + 6, rec.y + 6 + i * 16, "eigs> " + rline + "_", 240, 240, 255, 1]
        gfx_clip of null
    local id is rec.id
    task_step of id
    # resize grip: corner dots drawn AFTER the task so they stay
    # visible over whatever the window painted
    gfx_rect of [rec.x + rec.w - 5, rec.y + rec.h - 5, 3, 3, 120, 128, 152]
    gfx_rect of [rec.x + rec.w - 10, rec.y + rec.h - 5, 3, 3, 120, 128, 152]
    gfx_rect of [rec.x + rec.w - 5, rec.y + rec.h - 10, 3, 3, 120, 128, 152]
    return 0

ok is gfx_open of [1024, 768, "EigenOS desktop"]
if ok == 0:
    print of "desktop: no framebuffer (text console boot)"
if ok == 1:
    wins is []
    nslots is 0
    p0 is 0.0
    p1 is 0.0
    p2 is 0.0
    p3 is 0.0
    p4 is 0.0
    p5 is 0.0
    p6 is 0.0
    p7 is 0.0
    rline is ""
    rlines is []
    drag is 0 - 1
    rsz is 0 - 1
    gdx is 0
    gdy is 0
    spawn_win of ["win_counter", 60, 104, 300, 160, "counter", "plain"]
    spawn_win of ["win_bounce", 420, 164, 360, 240, "bounce", "plain"]
    spawn_win of ["task_stuck", 120, 420, 260, 120, "stuck worker", "plain"]
    spawn_win of ["win_repl", 480, 486, 480, 220, "repl -- its own EigsState", "repl"]
    spawn_win of ["win_vitals", 820, 104, 180, 240, "vitals", "plain"]
    to_top of 0
    running is 1
    loop while running == 1:
        ev is gfx_poll of null
        loop while ev != null:
            match ev.type:
                case "keydown":
                    if ev.key == "escape":
                        running is 0
                    foc is wins[(len of wins) - 1]
                    if foc.kind == "repl":
                        if (ev.code >= 32) and (ev.code < 127):
                            if (len of rline) < 52:
                                rline is rline + (chr of ev.code)
                        if ev.key == "backspace":
                            rn is len of rline
                            if rn > 0:
                                rline is substr of [rline, 0, rn - 1]
                        if ev.key == "return":
                            if (len of rline) > 0:
                                append of [rlines, "eigs> " + rline]
                                fid is foc.id
                                res is task_eval of [fid, rline]
                                if (len of res) > 0:
                                    append of [rlines, res]
                                loop while (len of rlines) > 11:
                                    rlines is list.drop of [rlines, 1]
                                rline is ""
                    if foc.kind != "repl":
                        if ev.key != "escape":
                            fid is foc.id
                            task_key of [fid, ev.code]
                case "mousedown":
                    press of [ev.x, ev.y]
                case "mousemove":
                    if drag >= 0:
                        drag_to of [ev.x, ev.y]
                    if rsz >= 0:
                        resize_to of [ev.x, ev.y]
                case "mouseup":
                    drag is 0 - 1
                    rsz is 0 - 1
            ev is gfx_poll of null

        # frame: desktop backdrop, then windows back-to-front (focused
        # last = on top); each window's health is sampled through its
        # observer slot on the way — a hung window's title reads red
        # because its progress trajectory IS `stable`.
        gfx_clear of [8, 9, 14]
        gfx_text of [12, 8, "EigenOS -- windows are observed bindings (esc quits)", 150, 160, 190, 2]
        wn is len of wins
        wi is 0
        loop while wi < wn:
            wrec is wins[wi]
            st is sample_health of [wrec.slot, wrec.id]
            focused is 0
            if wi == wn - 1:
                focused is 1
            draw_one of [wrec, focused, st]
            wi is wi + 1
        gfx_present of null
        gfx_delay of 25
    wi is 0
    loop while wi < (len of wins):
        wrec is wins[wi]
        kid is wrec.id
        task_kill of kid
        wi is wi + 1
    gfx_close of null
    print of "desktop: closed"
