# MD window task: a ball bouncing inside its own window. The task never
# learns where its window IS on screen — win_w/win_h give the content
# size, the viewport clip keeps every pixel inside. progress advances
# every step, so the WM's observer reads this window as healthy.
x is 30.0
y is 20.0
dx is 7.0
dy is 5.0
progress is 0.0

define step() as:
    progress is progress + 1
    local w is win_w of []
    local h is win_h of []
    if w > 0:
        x is x + dx
        y is y + dy
        if x < 12:
            dx is 0.0 - dx
            x is 12
        if x > w - 12:
            dx is 0.0 - dx
            x is w - 12
        if y < 12:
            dy is 0.0 - dy
            y is 12
        if y > h - 12:
            dy is 0.0 - dy
            y is h - 12
        gfx_clear of [16, 32, 28]
        gfx_circle of [x, y, 10, 120, 230, 150]
    return progress
