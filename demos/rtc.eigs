# The real-time clock, in EigenScript — a pure-script CMOS driver over
# the M12 port seam (ports 0x70 index / 0x71 data; no kernel C at all).
# Handles the update-in-progress window (read twice, retry on tear),
# BCD vs binary mode, 12h vs 24h mode (status register B), and turns
# the calendar into seconds-since-epoch (Hinnant civil-days). Reports
# the CMOS time AS STORED — UTC on this fleet (Ubuntu keeps CMOS in
# UTC on the T3200; QEMU defaults to host UTC).
#
#   import rtc
#   rtc.stamp of []      # "2026-07-04 05:12:33"
#   rtc.unix of []       # seconds since 1970-01-01 (numeric time key)
#   t is rtc.now of []   # {year, month, day, hour, minute, second}
#
# Disposition: port reads are raw device access and do NOT ride the M11
# tape (same as blk_read/pci) — a journal replay re-reads the live
# clock. Sample rtc.unix into a binding if you want the tape to carry a
# moment (assignments are recorded; the value travels with the session).

define cmos(reg) as:
    outb of [0x70, reg]
    return inb of 0x71

define wait_settled() as:
    local i is 0
    loop while i < 20000:
        if (bit_and of [(cmos of (0x0A)), 128]) == 0:
            return 1
        i is i + 1
    return 0

define fix(v, binmode) as:
    if binmode == 1:
        return v
    return ((v - (v % 16)) / 16) * 10 + (v % 16)

# One raw pass -> [sec, min, hour24, day, month, year2] (year2 = 0..99).
define read_raw() as:
    local b is cmos of (0x0B)
    local bin is 0
    if (bit_and of [b, 4]) != 0:
        bin is 1
    local h24 is 0
    if (bit_and of [b, 2]) != 0:
        h24 is 1
    local sec is fix of [cmos of (0x00), bin]
    local mn is fix of [cmos of (0x02), bin]
    local hr is cmos of (0x04)
    local pm is 0
    if h24 == 0:
        if hr >= 128:
            pm is 1
            hr is hr - 128
    hr is fix of [hr, bin]
    if h24 == 0:
        if (pm == 1) and (hr != 12):
            hr is hr + 12
        if (pm == 0) and (hr == 12):
            hr is 0
    local dy is fix of [cmos of (0x07), bin]
    local mo is fix of [cmos of (0x08), bin]
    local yr is fix of [cmos of (0x09), bin]
    return [sec, mn, hr, dy, mo, yr]

define now() as:
    wait_settled of []
    local a is read_raw of []
    local tries is 0
    loop while tries < 8:
        local c is read_raw of []
        if (c[0] == a[0]) and (c[1] == a[1]) and (c[2] == a[2]) and (c[3] == a[3]) and (c[4] == a[4]) and (c[5] == a[5]):
            return {"year": 2000 + a[5], "month": a[4], "day": a[3], "hour": a[2], "minute": a[1], "second": a[0]}
        a is c
        tries is tries + 1
    return {"year": 2000 + a[5], "month": a[4], "day": a[3], "hour": a[2], "minute": a[1], "second": a[0]}

# Days since 1970-01-01 for a civil date (Hinnant, exact integer math).
define days_civil(y, m, d) as:
    local yy is y
    if m <= 2:
        yy is yy - 1
    local era is (yy - (yy % 400)) / 400
    local yoe is yy - (era * 400)
    local mp is (m + 9) % 12
    local t is (153 * mp) + 2
    local doy is ((t - (t % 5)) / 5) + d - 1
    local doe is (yoe * 365) + ((yoe - (yoe % 4)) / 4) - ((yoe - (yoe % 100)) / 100) + doy
    return (era * 146097) + doe - 719468

define unix() as:
    local t is now of []
    local days is days_civil of [t.year, t.month, t.day]
    return (days * 86400) + (t.hour * 3600) + (t.minute * 60) + t.second

define pad2(v) as:
    if v < 10:
        return "0" + (str of v)
    return str of v

define stamp() as:
    local t is now of []
    return f"{str of t.year}-{pad2 of (t.month)}-{pad2 of (t.day)} {pad2 of (t.hour)}:{pad2 of (t.minute)}:{pad2 of (t.second)}"
