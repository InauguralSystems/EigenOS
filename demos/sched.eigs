# M9: the cooperative scheduler, in EigenScript.
#
# The kernel provides the MECHANISM (task_spawn/step/read/alive/kill —
# a task is an EigsState; a step is one eval). This module is POLICY.
# The observer idiom: sample a task's `progress` into a binding each
# round; a task whose progress reads `stable` is stalled.
#
#   import sched
#   a is task_spawn of "task_counter"
#   b is task_spawn of "task_stuck"
#   sched.round_robin of [[a, b], 14]

define round_robin(ids, rounds) as:
    local r is 0
    loop while r < rounds:
        for id in ids:
            if (task_alive of id):
                task_step of id
        r is r + 1
    return r
