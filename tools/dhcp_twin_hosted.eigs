print of "=== dhcp twin (DISCOVER/OFFER/REQUEST/ACK vs a scripted server) ==="

# ---- the full handshake ----
reset of ([frame of offer1, 0, frame of ack1])
l is dhcp.acquire of 400
check of ["acquire succeeds", l["ok"], 1]
check of ["lease ip", l["ip"], [10, 0, 2, 15]]
check of ["mask", l["mask"], [255, 255, 255, 0]]
check of ["gateway", l["gw"], [10, 0, 2, 2]]
check of ["dns", l["dns"], [10, 0, 2, 3]]
check of ["server id", l["server"], [10, 0, 2, 2]]
check of ["lease seconds", l["lease"], 86400]
check of ["lease committed into inet", inet.cfg["ip"], [10, 0, 2, 15]]
check of ["gateway committed", inet.cfg["gw"], [10, 0, 2, 2]]
check of ["exactly DISCOVER + REQUEST on the wire", len of t_sent, 2]
bytes_eq of ["DISCOVER bytes exact (net_tower_vectors.py)", t_sent[0], want_discover1]
bytes_eq of ["REQUEST bytes exact (option 50 + 54)", t_sent[1], want_request1]
check of ["lease dict is live module state", dhcp.lease["ip"], [10, 0, 2, 15]]

# ---- the serial-gate verdict string ----
reset of ([frame of offer2, frame of ack2])
s is dhcp.acquire_str of 400
check of ["verdict string exact", s, "lease 10.0.2.15 mask 255.255.255.0 gw 10.0.2.2 dns 10.0.2.3 server 10.0.2.2 for 86400s"]

# ---- planted faults ----
reset of ([frame of offer_wrongxid])
l is dhcp.acquire of 100
check of ["OFFER with wrong xid ignored", l["ok"], 0]

reset of ([frame of offer_badcookie])
l is dhcp.acquire of 100
check of ["OFFER with bad magic cookie ignored", l["ok"], 0]

reset of ([frame of offer_noserver])
l is dhcp.acquire of 100
check of ["OFFER without a server id not requested", l["ok"], 0]

reset of ([frame of offer6, 0, frame of nak6])
l is dhcp.acquire of 400
check of ["NAK fails the acquire honestly", l["ok"], 0]

reset of ([frame of offer7, 0, frame of ack_wrongxid])
l is dhcp.acquire of 400
check of ["ACK with wrong xid never commits", l["ok"], 0]
check of ["failed acquire leaves the config down", inet.cfg["up"], 0]
check of ["failed acquire leaves lease.ok 0", dhcp.lease["ok"], 0]

print of ""
if fails == 0:
    print of "dhcp twin: ALL PASS"
if fails > 0:
    print of f"dhcp twin: {str of fails} FAILURE(S)"
    exit of 1
