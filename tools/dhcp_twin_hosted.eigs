# Hosted twin harness for EigenOS demos/dhcp.eigs (M13-2 DHCP client).
# Stubs the frame seam and plays a scripted DHCP server against the
# client (frames precomputed by tools/net_tower_vectors.py, valid UDP
# checksums throughout so every fault is caught at the DHCP layer it
# belongs to). Asserts the exact DISCOVER/REQUEST bytes on the wire
# (xid = the taped-ticks schedule), the committed lease, and the
# planted faults: wrong xid, bad magic cookie, missing server id, NAK,
# wrong-xid ACK. Run from the EigenOS repo root:
#   (cd demos && eigenscript ../tools/dhcp_twin_hosted.eigs)
# Exits nonzero on any failure — run before touching demos/dhcp.eigs.

t_sent is []            # every net_send frame, captured as a byte list
t_feed is []            # frames net_recv serves (0 = "nothing pending")
t_fi is 0
t_tnow is 0

define net_mac() as:
    local m is buffer of 6
    local v is [0x52, 0x54, 0x00, 0x12, 0x34, 0x56]
    local i is 0
    loop while i < 6:
        buf_set of [m, i, v[i]]
        i is i + 1
    return m

define net_send(f) as:
    local n is buf_len of f
    local l is []
    local i is 0
    loop while i < n:
        append of [l, buf_get of [f, i]]
        i is i + 1
    append of [t_sent, l]
    return 1

define net_recv() as:
    if t_fi >= (len of t_feed):
        return null
    local x is t_feed[t_fi]
    t_fi is t_fi + 1
    if (type of x) == "buffer":
        return x
    return null

define gfx_delay(ms) as:
    return 1

define gfx_ticks() as:
    t_tnow is t_tnow + 50
    return t_tnow

fails is 0

define reset(tape) as:
    t_sent is []
    t_feed is tape
    t_fi is 0

define check(tag, got, want) as:
    if got == want:
        print of f"  PASS: {tag}"
    if got != want:
        print of f"  FAIL: {tag} (got {str of got}, wanted {str of want})"
        fails is fails + 1

define frame(bytes) as:
    local f is buffer of (len of bytes)
    local i is 0
    loop while i < (len of bytes):
        buf_set of [f, i, bytes[i]]
        i is i + 1
    return f

define extend(dst, xs) as:
    local i is 0
    loop while i < (len of xs):
        append of [dst, xs[i]]
        i is i + 1

define bytes_eq(tag, got, want) as:
    if (len of got) != (len of want):
        check of [tag, len of got, len of want]
        return 0
    local bad is 0
    local i is 0
    loop while i < (len of want):
        if got[i] != want[i]:
            bad is bad + 1
            print of f"    byte {str of i}: got {str of got[i]}, wanted {str of want[i]}"
        i is i + 1
    check of [tag, bad, 0]
    return 1

