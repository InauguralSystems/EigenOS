# Hosted twin harness for EigenOS demos/desktop.eigs (list-driven WM).
# Stubs the kernel seams (task_* / gfx_*) in pure EigenScript, feeds the
# WM a scripted event tape, then asserts the list state: z-order after
# clicks, drag arithmetic + clamps, grip-resize arithmetic + minimum
# clamps, key routing to focus, repl transcript via task_eval, teardown,
# and the observer verdict through the slot dispatch (stuck reads
# stable, advancing does not).
# Run from the sibling EigenScript repo root (import list needs its lib/):
#   cd ../EigenScript && ./src/eigenscript ../EigenOS/tools/desktop_twin_hosted.eigs
# Exits nonzero on any failure — the WM regression gate for MD work.

# ---- stub state ----
spawned is []
prog is {}
stuckmods is {}
alivemap is {}
ai is 0
loop while ai < 8:
    alivemap[str of ai] is 0
    ai is ai + 1
keyslog is []
wheellog is []
evals is []
views is {}
viewlog is []
killed is 0
fnum is 0
tape is []
tapei is 0

# ---- kernel task seams ----
define task_spawn(mod) as:
    # kernel-faithful (hal.c): lowest free slot 0..7, ids are REUSED
    # after a kill (MAX_TASKS = 8), a full table refuses with -1
    local id is 0 - 1
    local i is 0
    loop while i < 8:
        if (alivemap[str of i] == 0) and (id < 0):
            id is i
        i is i + 1
    if id < 0:
        return 0 - 1
    append of [spawned, mod]
    local k is str of id
    alivemap[k] is 1
    prog[k] is 1.0
    stuckmods[k] is 0
    if mod == "task_stuck":
        prog[k] is 3.0
        stuckmods[k] is 1
    return id

define task_step(id) as:
    local k is str of id
    if stuckmods[k] == 0:
        prog[k] is prog[k] + 1
    return 0

define task_read(id, name) as:
    local k is str of id
    return prog[k]

define task_view(id, x, y, w, h) as:
    local k is str of id
    views[k] is [x, y, w, h]
    append of [viewlog, [id, x, y, w, h]]
    return 0

define task_key(id, code) as:
    append of [keyslog, [id, code]]
    return 0

define task_wheel(id, dy) as:
    append of [wheellog, [id, dy]]
    return 1

define task_eval(id, src) as:
    append of [evals, [id, src]]
    return "42stub"

define task_kill(id) as:
    alivemap[str of id] is 0
    killed is killed + 1
    return 0

# ---- gfx seams (drawing is a no-op; poll/delay drive the tape) ----
define gfx_open(w, h, title) as:
    return 1

define gfx_close(x) as:
    return 0

define gfx_rect(x, y, w, h, r, g, b) as:
    return 0

define gfx_text(x, y, s, r, g, b, size) as:
    return 0

define gfx_circle(x, y, rr, r, g, b) as:
    return 0

define gfx_clip(a, b is 0, c is 0, d is 0) as:
    return 0

define gfx_clear(r, g, b) as:
    return 0

define gfx_present(x) as:
    return 0

define gfx_delay(ms) as:
    fnum is fnum + 1
    return 0

define gfx_poll(x) as:
    if tapei < (len of tape):
        local pair is tape[tapei]
        if pair[0] <= fnum:
            tapei is tapei + 1
            return pair[1]
    return null

# ---- the event tape ----
# initial spawn order: 0 counter, 1 bounce, 2 stuck, 3 repl, 4 vitals;
# to_top(0) makes counter focused (last).
append of [tape, [5, {"type": "mousedown", "x": 600, "y": 150}]]
append of [tape, [6, {"type": "mousemove", "x": 700, "y": 230}]]
append of [tape, [7, {"type": "mouseup"}]]
append of [tape, [10, {"type": "keydown", "key": "x", "code": 120}]]
append of [tape, [11, {"type": "wheel", "x": 0, "y": 0 - 1}]]
append of [tape, [12, {"type": "mousedown", "x": 200, "y": 180}]]
append of [tape, [14, {"type": "keydown", "key": "a", "code": 97}]]
append of [tape, [15, {"type": "wheel", "x": 0, "y": 1}]]
append of [tape, [15, {"type": "wheel", "x": 0, "y": 1}]]
append of [tape, [16, {"type": "mousedown", "x": 500, "y": 470}]]
append of [tape, [17, {"type": "mouseup"}]]
append of [tape, [18, {"type": "keydown", "key": "6", "code": 54}]]
append of [tape, [19, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [20, {"type": "keydown", "key": "*", "code": 42}]]
append of [tape, [21, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [22, {"type": "keydown", "key": "7", "code": 55}]]
append of [tape, [23, {"type": "keydown", "key": "return", "code": 13}]]
# block input: "if 1:" opens a block, " x is 9" accumulates, a blank
# line submits the whole block in ONE task_eval
append of [tape, [24, {"type": "keydown", "key": "i", "code": 105}]]
append of [tape, [24, {"type": "keydown", "key": "f", "code": 102}]]
append of [tape, [24, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [24, {"type": "keydown", "key": "1", "code": 49}]]
append of [tape, [24, {"type": "keydown", "key": ":", "code": 58}]]
append of [tape, [24, {"type": "keydown", "key": "return", "code": 13}]]
append of [tape, [25, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [25, {"type": "keydown", "key": "x", "code": 120}]]
append of [tape, [25, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [25, {"type": "keydown", "key": "i", "code": 105}]]
append of [tape, [25, {"type": "keydown", "key": "s", "code": 115}]]
append of [tape, [25, {"type": "keydown", "key": "space", "code": 32}]]
append of [tape, [25, {"type": "keydown", "key": "9", "code": 57}]]
append of [tape, [25, {"type": "keydown", "key": "return", "code": 13}]]
append of [tape, [26, {"type": "keydown", "key": "return", "code": 13}]]
append of [tape, [28, {"type": "mousedown", "x": 900, "y": 200}]]
append of [tape, [29, {"type": "mousedown", "x": 30, "y": 700}]]
# resize vitals (focused, at 820,104,180,240): grab the grip with an
# offset from the corner (-5,-4), drop the corner near (1015,424)
append of [tape, [30, {"type": "mousedown", "x": 995, "y": 340}]]
append of [tape, [31, {"type": "mousemove", "x": 1010, "y": 420}]]
append of [tape, [32, {"type": "mouseup"}]]
# then shrink it far below the minimums: the clamp must hold
append of [tape, [34, {"type": "mousedown", "x": 1008, "y": 418}]]
append of [tape, [35, {"type": "mousemove", "x": 830, "y": 120}]]
append of [tape, [36, {"type": "mouseup"}]]
# launcher: chips sit at [64+i*64, 64+i*64+56) on the y<28 bar. Launch
# a second bounce, counter, stuck (slots 5,6,7 -> budget empty), then
# a REFUSED vitals (0 free); close the new stuck via its title-bar x
# (frees slot 7 + kernel id 7); relaunch vitals into the reused id+slot
append of [tape, [40, {"type": "mousedown", "x": 156, "y": 14}]]
append of [tape, [42, {"type": "mousedown", "x": 92, "y": 14}]]
append of [tape, [44, {"type": "mousedown", "x": 220, "y": 14}]]
append of [tape, [46, {"type": "mousedown", "x": 348, "y": 14}]]
append of [tape, [48, {"type": "mousedown", "x": 420, "y": 130}]]
append of [tape, [50, {"type": "mousedown", "x": 348, "y": 14}]]
append of [tape, [80, {"type": "keydown", "key": "escape", "code": 27}]]

# ---- run the WM ----
load_file of "../EigenOS/demos/desktop.eigs"

# ---- assertions ----
fails is 0

define check(label, got, want) as:
    if got == want:
        print of ("PASS " + label)
    if got != want:
        fails is fails + 1
        print of ("FAIL " + label + ": got " + (str of got) + " want " + (str of want))
    return 0

# z-order after the click sequence: stuck, bounce, counter, repl,
# vitals, then the three launched windows
check of ["z0 stuck back", wins[0].id, 2]
check of ["z1 bounce", wins[1].id, 1]
check of ["z2 counter", wins[2].id, 0]
check of ["z3 repl", wins[3].id, 3]
check of ["z4 vitals", wins[4].id, 4]

# drag moved bounce: grab at (600,150) offset (180,-14), drop pointer at
# (700,230) -> window (520,244); record and viewport must agree
check of ["drag x", wins[1].x, 520]
check of ["drag y", wins[1].y, 244]
bview is views["1"]
check of ["view x", bview[0], 520]
check of ["view y", bview[1], 244]
check of ["view w", bview[2], 360]
check of ["view h", bview[3], 240]

# key routing followed focus: 'x' to bounce (focused after f5 click),
# 'a' to counter (focused after f12 click); escape/repl keys never routed
check of ["keylog count", len of keyslog, 2]
check of ["key1 to bounce", keyslog[0][0], 1]
check of ["key1 code", keyslog[0][1], 120]
check of ["key2 to counter", keyslog[1][0], 0]
check of ["key2 code", keyslog[1][1], 97]

# wheel routes to the focused window exactly like keys: one notch down
# while bounce held focus, two notches up after focus moved to counter
check of ["wheel count", len of wheellog, 3]
check of ["wheel1 to bounce", wheellog[0][0], 1]
check of ["wheel1 dy", wheellog[0][1], 0 - 1]
check of ["wheel2 to counter", wheellog[1][0], 0]
check of ["wheel2 dy", wheellog[1][1], 1]
check of ["wheel3 to counter", wheellog[2][0], 0]

# the repl line assembled + evaled on the repl task; the transcript
# lives in the window RECORD (each repl window owns its own); the
# ':'-block accumulated two lines and submitted as ONE eval with the
# newline join, then cleared the block state
rw is wins[3]
check of ["eval count", len of evals, 2]
check of ["eval on repl state", evals[0][0], 3]
check of ["eval src", evals[0][1], "6 * 7"]
check of ["block eval on repl state", evals[1][0], 3]
check of ["block eval src", evals[1][1], "if 1:\n x is 9"]
check of ["rlines count", len of rw.rlines, 5]
check of ["rlines echo", rw.rlines[0], "eigs> 6 * 7"]
check of ["rlines result", rw.rlines[1], "42stub"]
check of ["rlines block open", rw.rlines[2], "eigs> if 1:"]
check of ["rlines block cont", rw.rlines[3], "....>  x is 9"]
check of ["rlines block result", rw.rlines[4], "42stub"]
check of ["rline cleared", rw.rline, ""]
check of ["rblock cleared", rw.rblock, ""]

# resize: the grow drag put vitals at 195x320 (corner offset -5,-4,
# pointer at 1010,420) — proven from the viewport history; the shrink
# drag hit the 120x60 minimum clamp and stayed there; the grip press
# focused but never dragged (x,y untouched)
grow_seen is 0
for ve in viewlog:
    if (ve[0] == 4) and (ve[3] == 195) and (ve[4] == 320):
        grow_seen is 1
check of ["resize grow logged", grow_seen, 1]
check of ["resize clamp w", wins[4].w, 120]
check of ["resize clamp h", wins[4].h, 60]
check of ["resize kept x", wins[4].x, 820]
check of ["resize kept y", wins[4].y, 104]
vview is views["4"]
check of ["resize view w", vview[2], 120]
check of ["resize view h", vview[3], 60]

# launcher: three launches filled the slot budget (5,6,7 cascade-
# placed), the fourth was refused BEFORE task_spawn (9 spawn calls
# total, not 10), the close killed the task and freed its slot, the
# relaunch reused the kernel id AND the slot, and by ESC the reused
# slot's trajectory has recovered from its previous tenant (the new
# vitals reads advancing, not the dead stuck's stable)
check of ["eight windows", len of wins, 8]
check of ["launch2 id", wins[5].id, 5]
check of ["launch2 title", wins[5].title, "bounce"]
check of ["launch2 x", wins[5].x, 80]
check of ["launch2 y", wins[5].y, 70]
check of ["launch3 id", wins[6].id, 6]
check of ["relaunch reused id", wins[7].id, 7]
check of ["relaunch title", wins[7].title, "vitals"]
check of ["relaunch slot", wins[7].slot, 7]
check of ["relaunch cascade x", wins[7].x, 212]
check of ["spawn calls", len of spawned, 9]
check of ["budget empty", len of freeslots, 0]
check of ["reused slot recovered", sample_health of [7, 7], 0]

# teardown killed every remaining window (8) + the one closed live
check of ["killed all", killed, 9]

# observer through the slot dispatch: the wedged task (slot 2) reads
# stable; the advancing counter (slot 0) does not
check of ["stuck reads stable", sample_health of [2, 2], 1]
check of ["advancing not stable", sample_health of [0, 0], 0]

print of ("HARNESS failures: " + (str of fails))
if fails > 0:
    throw of "desktop twin harness FAILED"
